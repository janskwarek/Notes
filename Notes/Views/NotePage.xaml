<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Notes.NotePage.Views"
             xmlns:models ="clr-namespace:Notes.Models"
             x:DataType="models:Note">
    <ContentPage.Content>
        <VerticalStackLayout
            Spacing="10" Margin="5">
            <Editor x:Name="TextEditor" Text="{Binding Text}" Placeholder="{Binding EditerPlaceHolder}" HeightRequest="100"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                <Button Grid.Column="0" Text="{Binding SaveButtonText}" Clicked="SaveButton_Clicked"/>
                <Button Grid.Column="1" Text="{Binding DeleteButtonText}" Clicked="DeleteButton_Clicked"/>
            </Grid>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>